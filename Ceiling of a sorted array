// User function Template for C++
class Solution {
  public:
    int findCeil(vector<int>& arr, int x) {
        int n = arr.size();
        int lo = 0;
        int hi = n-1;
        int ans = -1;
        while(hi>=lo){
            int mid = lo + (hi-lo)/2;
            if(arr[mid]>=x){
                ans = mid;
                hi = mid-1;
            }
            else lo = mid+1;
        }
        return ans;
    }
};
